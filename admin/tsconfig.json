{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@routes": ["./src/routes"],
      "@core/*": ["../core/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.vue", "env.d.ts", "../core/**/*"],
  "watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriority"
  }
}
