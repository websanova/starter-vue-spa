{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@routes": ["./src/routes"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.vue", "env.d.ts", "../shared/**/*"],
  "watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriority"
  }
}
